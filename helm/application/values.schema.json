{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "service", "ingress", "persistence", "strategy"],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "replicaCount": {"type": "integer", "minimum": 0},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "command": {"$ref": "#/definitions/stringArray"},
    "args": {"$ref": "#/definitions/stringArray"},
    "env": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {"type": ["string", "number", "boolean"]}
      },
      "additionalProperties": false
    },
    "secretEnv": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1},
            "optional": {"type": "boolean"}
          }
        }
      },
      "additionalProperties": false
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "oneOf": [{"required": ["secretRef"]}, {"required": ["configMapRef"]}]
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "targetPort", "portName"],
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"$ref": "#/definitions/port"},
        "targetPort": {"$ref": "#/definitions/port"},
        "portName": {"type": "string", "maxLength": 15, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "path", "pathType"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "host": {"type": "string"},
        "path": {"type": "string", "pattern": "^/"},
        "pathType": {"enum": ["Prefix", "Exact", "ImplementationSpecific"]},
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": {"type": "string", "minLength": 1},
              "hosts": {"$ref": "#/definitions/stringArray"}
            }
          }
        }
      }
    },
    "healthCheckPath": {"type": "string", "pattern": "^/"},
    "startupProbe": {"$ref": "#/definitions/probe"},
    "readinessProbe": {"$ref": "#/definitions/probe"},
    "livenessProbe": {"$ref": "#/definitions/probe"},
    "resources": {"type": "object"},
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size", "mountPath", "accessModes"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClassName": {"type": "string"},
        "size": {"type": "string", "minLength": 1},
        "mountPath": {"type": "string", "pattern": "^/"},
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"]}
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["RollingUpdate", "Recreate"]},
        "rollingUpdate": {"type": "object"}
      }
    },
    "hostname": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"}
  },
  "definitions": {
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "probe": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "httpGet": {
              "type": ["object", "null"],
              "required": ["path", "port"],
              "properties": {
                "path": {"type": "string", "pattern": "^/"},
                "port": {"type": ["string", "integer"]}
              }
            },
            "exec": {
              "type": ["object", "null"],
              "required": ["command"],
              "properties": {
                "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            },
            "tcpSocket": {"type": ["object", "null"]},
            "grpc": {"type": ["object", "null"]}
          }
        }
      ]
    }
  }
}
